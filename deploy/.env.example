# Copiar a deploy/.env y ajustar antes de `docker compose up -d --build`
#
# En el VPS, FRONTEND_URL debe ser la URL que uses en el navegador (IP o dominio + puerto web).
# Ejemplo: http://203.0.113.10:8080

# --- Puertos expuestos en el host ---
WEB_PORT=8080
PORTAINER_HTTP_PORT=9000

# --- Base de datos (solo red interna Docker; no publicar 3306 en producción) ---
MARIADB_ROOT_PASSWORD=cambia_esta_clave_root
MARIADB_DATABASE=club360

# --- API NestJS ---
# Obligatorio en producción (mín. 32 caracteres). PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_minimo_32_chars

JWT_ACCESS_SECONDS=1800
JWT_REFRESH_SECONDS=604800

# URL pública de la app (CORS). Debe coincidir con cómo abrís el frontend.
FRONTEND_URL=http://localhost:8080

# 1 = marca instalación completada y arranca API sin wizard (recomendado con db-init)
# 0 = primer arranque muestra asistente de instalación en el navegador
CLUB360_AUTO_INSTALL=1
