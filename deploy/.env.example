# Copiar a deploy/.env y ajustar antes de `docker compose up -d --build`
#
# En el VPS, FRONTEND_URL debe ser la URL que uses en el navegador (IP o dominio + puerto web).
# Ejemplo: http://203.0.113.10:8080

# --- Puertos expuestos en el host ---
WEB_PORT=8080
PORTAINER_HTTP_PORT=9000

# --- Base de datos (solo red interna Docker; no publicar 3306 en producción) ---
MARIADB_ROOT_PASSWORD=cambia_esta_clave_root
MARIADB_DATABASE=club360

# --- API NestJS ---
# Obligatorio en producción (mín. 32 caracteres). PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_minimo_32_chars

JWT_ACCESS_SECONDS=1800
JWT_REFRESH_SECONDS=604800

# URL pública de la app (CORS). Debe coincidir con cómo abrís el frontend.
FRONTEND_URL=http://localhost:8080

# Caché Redis (API). En Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# 0 = asistente web aplica esquema + seed (recomendado)
# 1 = salta wizard y marca instalación hecha (solo si la BD ya está preparada)
CLUB360_AUTO_INSTALL=0

BACKUP_RETENTION_COUNT=8
BACKUPS_ENABLED=true
# Carpeta de backups en el host VPS (fuera del repo)
BACKUPS_HOST_DIR=/opt/backup

# --- MCP (agentes remotos vía https://mcp.unogym.online) ---
# Usuario Club360 con permisos de operador (admin recomendado para bot Telegram)
MCP_CLUB360_USERNAME=admin
MCP_CLUB360_PASSWORD=cambia_password_admin_club360

# Token para el agente: Authorization: Bearer <token>
# Generar: openssl rand -hex 32
MCP_HTTP_BEARER_TOKEN=cambia_por_token_largo_aleatorio

MCP_PUBLIC_URL=https://mcp.unogym.online
CLUB360_REQUEST_TIMEOUT_MS=30000
