# Club360 — contenedor único de base de datos:
#   MariaDB (datos) + supercronic (backup semanal → /backups bind-mount al host)
FROM mariadb:11.4

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && curl -fsSL -o /usr/local/bin/supercronic \
    https://github.com/aptible/supercronic/releases/download/v0.2.33/supercronic-linux-amd64 \
  && chmod +x /usr/local/bin/supercronic \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

COPY services/database/scripts/backup.sh /scripts/backup.sh
COPY services/database/scripts/restore.sh /scripts/restore.sh
COPY services/database/scripts/crontab /scripts/crontab
COPY services/database/scripts/entrypoint-db.sh /usr/local/bin/entrypoint-db.sh
RUN chmod +x /scripts/backup.sh /scripts/restore.sh /usr/local/bin/entrypoint-db.sh

VOLUME ["/backups"]

ENTRYPOINT ["/usr/local/bin/entrypoint-db.sh"]
CMD ["mariadbd", "--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci"]
