# URL base de la API (incluye /api)
CLUB360_API_URL=http://localhost:3000/api

# Cuenta fija del operador (admin o staff)
CLUB360_USERNAME=admin
CLUB360_PASSWORD=

# Timeout HTTP (ms)
CLUB360_REQUEST_TIMEOUT_MS=30000

# stdio (default) | http
MCP_TRANSPORT=stdio

# Solo si MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100

# Obligatorio en producción HTTP (agente remoto): Authorization: Bearer <token>
MCP_HTTP_BEARER_TOKEN=

# URL pública vía Cloudflare (informativa en /health)
MCP_PUBLIC_URL=https://mcp.unogym.online
