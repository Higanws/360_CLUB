{
  "name": "@club360/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server autocontenido para Club360 (REST API wrapper)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "club360-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r resources dist/resources",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/index.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "smoke": "tsx src/smoke-test.ts",
    "agent-test": "tsx src/agent-mcp-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
